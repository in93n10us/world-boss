# Environment Variables Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# =============================================================================
# Server Configuration
# =============================================================================

# Server host address (use 0.0.0.0 to bind to all interfaces)
SERVER_HOST=127.0.0.1

# Server port
SERVER_PORT=8000

# Environment: development, staging, production
ENVIRONMENT=development

# Log level: trace, debug, info, warn, error
LOG_LEVEL=debug

# Enable JSON formatted logs (true for production, false for development)
LOG_JSON=false

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection URL
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://studyflow:studyflow@localhost:5432/studyflow_dev

# Maximum number of connections in the pool
DATABASE_MAX_CONNECTIONS=5

# Minimum number of idle connections in the pool
DATABASE_MIN_CONNECTIONS=1

# Connection timeout in seconds
DATABASE_CONNECT_TIMEOUT=30

# Idle connection timeout in seconds
DATABASE_IDLE_TIMEOUT=600

# Enable SQLx query logging
DATABASE_LOG_QUERIES=true

# =============================================================================
# JWT Authentication Configuration
# =============================================================================

# JWT secret key for signing tokens (generate a strong random string)
# Example: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration time in seconds (default: 24 hours)
JWT_EXPIRATION_SECONDS=86400

# JWT refresh token expiration in seconds (default: 7 days)
JWT_REFRESH_EXPIRATION_SECONDS=604800

# JWT issuer identifier
JWT_ISSUER=studyflow-api

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed origins for CORS (comma-separated list)
# Use * for development only, specify exact origins in production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Allow credentials in CORS requests
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# Security Configuration
# =============================================================================

# Bcrypt password hashing cost (10-12 recommended, higher = more secure but slower)
BCRYPT_COST=12

# Rate limiting: maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Rate limiting: time window in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Application Features
# =============================================================================

# Enable user registration
ENABLE_REGISTRATION=true

# Enable email verification (requires email service configuration)
ENABLE_EMAIL_VERIFICATION=false

# Maximum tasks per user (0 = unlimited)
MAX_TASKS_PER_USER=1000

# Maximum study sessions per task (0 = unlimited)
MAX_SESSIONS_PER_TASK=100

# =============================================================================
# Email Service Configuration (Optional)
# =============================================================================

# SMTP server host
# SMTP_HOST=smtp.example.com

# SMTP server port
# SMTP_PORT=587

# SMTP username
# SMTP_USERNAME=noreply@studyflow.com

# SMTP password
# SMTP_PASSWORD=your-smtp-password

# Email sender address
# EMAIL_FROM=StudyFlow <noreply@studyflow.com>

# =============================================================================
# External Services (Optional)
# =============================================================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Redis URL for caching and sessions (optional)
# REDIS_URL=redis://localhost:6379

# =============================================================================
# Testing Configuration
# =============================================================================

# Test database URL (used for integration tests)
TEST_DATABASE_URL=postgres://studyflow:studyflow@localhost:5432/studyflow_test

# =============================================================================
# Development Tools
# =============================================================================

# Enable GraphQL playground in development
ENABLE_GRAPHQL_PLAYGROUND=true

# Enable API documentation endpoint
ENABLE_API_DOCS=true

# Enable request/response body logging (development only)
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false